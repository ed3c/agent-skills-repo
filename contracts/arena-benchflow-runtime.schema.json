{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/agent-skills-repo/contracts/arena-benchflow-runtime.schema.json",
  "title": "Arena BenchFlow runtime evidence documents",
  "oneOf": [
    {"$ref": "#/$defs/runtime_policy"},
    {"$ref": "#/$defs/catalog_evidence"},
    {"$ref": "#/$defs/preparation"},
    {"$ref": "#/$defs/paired_result"},
    {"$ref": "#/$defs/benchflow_evidence"},
    {"$ref": "#/$defs/public_keys"},
    {"$ref": "#/$defs/runtime_summary"},
    {"$ref": "#/$defs/artifact_manifest"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]{0,191}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "runtime_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_id",
        "benchflow_version",
        "agent",
        "model",
        "catalog_model_id",
        "sandbox",
        "sandbox_profile_id",
        "task_id",
        "task_family",
        "task_bundle_digest",
        "candidate_skill_name",
        "usage_tracking",
        "max_retries",
        "concurrency",
        "skill_nudge",
        "network_policy",
        "allowed_tools",
        "sandbox_setup_timeout_sec",
        "agent_timeout_sec",
        "agent_idle_timeout_sec",
        "process_timeout_sec",
        "repetitions",
        "catalog_api_version",
        "catalog_url"
      ],
      "properties": {
        "schema_version": {"const": "arena-benchflow-runtime-policy@1"},
        "policy_id": {"$ref": "#/$defs/identifier"},
        "benchflow_version": {"const": "0.6.3"},
        "agent": {"const": "pi-acp"},
        "model": {"const": "github-models/openai/gpt-4.1-mini"},
        "catalog_model_id": {"const": "openai/gpt-4.1-mini"},
        "sandbox": {"const": "docker"},
        "sandbox_profile_id": {"$ref": "#/$defs/identifier"},
        "task_id": {"const": "dialogue-parser"},
        "task_family": {"const": "code"},
        "task_bundle_digest": {
          "const": "sha256:822261046590e0521d715920df5612c55c2d76b1cc3bb3f43aa45123d2ed2b57"
        },
        "candidate_skill_name": {"const": "dialogue-graph"},
        "usage_tracking": {"const": "required"},
        "max_retries": {"const": 0},
        "concurrency": {"const": 1},
        "skill_nudge": {"const": "name"},
        "network_policy": {"enum": ["public", "no-network"]},
        "allowed_tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "sandbox_setup_timeout_sec": {"type": "integer", "minimum": 1},
        "agent_timeout_sec": {"type": "integer", "minimum": 1},
        "agent_idle_timeout_sec": {"type": "integer", "minimum": 1},
        "process_timeout_sec": {"type": "integer", "minimum": 1},
        "repetitions": {"type": "integer", "minimum": 3, "maximum": 100},
        "catalog_api_version": {"const": "2026-03-10"},
        "catalog_url": {"const": "https://models.github.ai/catalog/models"}
      }
    },
    "catalog_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "catalog_url",
        "api_version",
        "model_id",
        "name",
        "publisher",
        "registry",
        "version",
        "capabilities",
        "limits",
        "rate_limit_tier",
        "fetched_at",
        "evidence_digest"
      ],
      "properties": {
        "schema_version": {"const": "github-models-catalog-evidence@1"},
        "catalog_url": {"const": "https://models.github.ai/catalog/models"},
        "api_version": {"const": "2026-03-10"},
        "model_id": {"const": "openai/gpt-4.1-mini"},
        "name": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "registry": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "limits": {"type": "object"},
        "rate_limit_tier": {"type": "string", "minLength": 1},
        "fetched_at": {"$ref": "#/$defs/timestamp"},
        "evidence_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "task_bundle_digest",
        "candidate_skill_name",
        "candidate_skill_artifact_digest",
        "environment_image_digest",
        "docker_server_version",
        "runtime_policy_digest",
        "model_catalog_evidence_digest",
        "effective_policy_digest",
        "allowed_tools_digest",
        "preparation_digest"
      ],
      "properties": {
        "schema_version": {"const": "arena-benchflow-preparation@1"},
        "task_id": {"const": "dialogue-parser"},
        "task_bundle_digest": {"$ref": "#/$defs/sha256"},
        "candidate_skill_name": {"const": "dialogue-graph"},
        "candidate_skill_artifact_digest": {"$ref": "#/$defs/sha256"},
        "environment_image_digest": {"$ref": "#/$defs/sha256"},
        "docker_server_version": {"type": "string", "minLength": 1},
        "runtime_policy_digest": {"$ref": "#/$defs/sha256"},
        "model_catalog_evidence_digest": {"$ref": "#/$defs/sha256"},
        "effective_policy_digest": {"$ref": "#/$defs/sha256"},
        "allowed_tools_digest": {"$ref": "#/$defs/sha256"},
        "preparation_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "paired_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation_id",
        "pairing_key",
        "repetition",
        "arm",
        "classification",
        "reward",
        "input_tokens",
        "output_tokens",
        "cost_microunits",
        "latency_ms"
      ],
      "properties": {
        "invocation_id": {"$ref": "#/$defs/identifier"},
        "pairing_key": {"$ref": "#/$defs/sha256"},
        "repetition": {"type": "integer", "minimum": 1},
        "arm": {"enum": ["baseline", "candidate"]},
        "classification": {
          "enum": [
            "succeeded",
            "task_failure",
            "verifier_failure",
            "agent_refusal",
            "timeout",
            "transport_loss",
            "infrastructure_failure"
          ]
        },
        "reward": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cost_microunits": {"type": "integer", "minimum": 0},
        "latency_ms": {"type": "integer", "minimum": 0}
      }
    },
    "arm_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned",
        "scored",
        "successes",
        "mean_reward",
        "total_input_tokens",
        "total_output_tokens",
        "total_cost_microunits",
        "total_latency_ms"
      ],
      "properties": {
        "planned": {"type": "integer", "minimum": 3},
        "scored": {"type": "integer", "minimum": 0},
        "successes": {"type": "integer", "minimum": 0},
        "mean_reward": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "total_input_tokens": {"type": "integer", "minimum": 0},
        "total_output_tokens": {"type": "integer", "minimum": 0},
        "total_cost_microunits": {"type": "integer", "minimum": 0},
        "total_latency_ms": {"type": "integer", "minimum": 0}
      }
    },
    "paired_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "experiment_id",
        "plan_digest",
        "task_digest",
        "rows",
        "arms",
        "observed_reward_lift",
        "ranking_claim_allowed",
        "reason",
        "result_digest"
      ],
      "properties": {
        "schema_version": {"const": "arena-paired-result@1"},
        "experiment_id": {"$ref": "#/$defs/identifier"},
        "plan_digest": {"$ref": "#/$defs/sha256"},
        "task_digest": {"$ref": "#/$defs/sha256"},
        "rows": {
          "type": "array",
          "minItems": 6,
          "items": {"$ref": "#/$defs/paired_row"}
        },
        "arms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "candidate"],
          "properties": {
            "baseline": {"$ref": "#/$defs/arm_summary"},
            "candidate": {"$ref": "#/$defs/arm_summary"}
          }
        },
        "observed_reward_lift": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
        "ranking_claim_allowed": {"const": false},
        "reason": {"type": "string", "minLength": 1},
        "result_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "benchflow_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_digest",
        "arm",
        "skill_mode",
        "tool_names",
        "unknown_tools",
        "usage_tracking",
        "agent_result",
        "return_code",
        "runtime_policy_digest",
        "effective_policy_digest",
        "environment_image_digest"
      ],
      "properties": {
        "schema_version": {"const": "arena-benchflow-evidence@1"},
        "task_digest": {"$ref": "#/$defs/sha256"},
        "arm": {"enum": ["baseline", "candidate"]},
        "skill_mode": {"enum": ["no-skill", "with-skill"]},
        "tool_names": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "unknown_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "usage_tracking": {"type": "object"},
        "agent_result": {"type": "object"},
        "return_code": {"type": "integer"},
        "runtime_policy_digest": {"$ref": "#/$defs/sha256"},
        "effective_policy_digest": {"$ref": "#/$defs/sha256"},
        "environment_image_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "public_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "purpose", "algorithm", "public_key_base64"],
      "properties": {
        "key_id": {"$ref": "#/$defs/identifier"},
        "purpose": {"enum": ["experiment-preregistration", "experiment-bundle"]},
        "algorithm": {"const": "Ed25519"},
        "public_key_base64": {"type": "string", "minLength": 43, "maxLength": 44}
      }
    },
    "public_keys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "keys"],
      "properties": {
        "schema_version": {"const": "arena-experiment-public-keys@1"},
        "keys": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/public_key"}
        }
      }
    },
    "runtime_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "run_identity",
        "task_id",
        "agent",
        "model",
        "model_catalog_version",
        "bundle_path",
        "bundle_manifest_hash",
        "plan_digest",
        "preparation_digest",
        "paired_result_digest",
        "started_at",
        "completed_at",
        "ranking_claim_allowed"
      ],
      "properties": {
        "schema_version": {"const": "arena-real-runtime-summary@1"},
        "status": {"const": "complete"},
        "run_identity": {"$ref": "#/$defs/identifier"},
        "task_id": {"const": "dialogue-parser"},
        "agent": {"const": "pi-acp"},
        "model": {"const": "github-models/openai/gpt-4.1-mini"},
        "model_catalog_version": {"type": "string", "minLength": 1},
        "bundle_path": {"type": "string", "pattern": "^bundles/sha256-[0-9a-f]{64}$"},
        "bundle_manifest_hash": {"$ref": "#/$defs/sha256"},
        "plan_digest": {"$ref": "#/$defs/sha256"},
        "preparation_digest": {"$ref": "#/$defs/sha256"},
        "paired_result_digest": {"$ref": "#/$defs/sha256"},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "completed_at": {"$ref": "#/$defs/timestamp"},
        "ranking_claim_allowed": {"const": false}
      }
    },
    "artifact_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "artifact_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "files", "manifest_digest"],
      "properties": {
        "schema_version": {"const": "arena-runtime-artifact-manifest@1"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact_file"}
        },
        "manifest_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
