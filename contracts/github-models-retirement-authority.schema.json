{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/agent-skills-repo/contracts/github-models-retirement-authority.schema.json",
  "title": "GitHub Models retirement source and enforcement authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_statement",
    "enforcement_policy",
    "record_digest"
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "login", "database_id", "node_id", "profile_url"],
      "properties": {
        "kind": {"const": "github-account"},
        "login": {"pattern": "^[A-Za-z0-9-]+$"},
        "database_id": {"type": "integer", "minimum": 1},
        "node_id": {"type": "string", "minLength": 1},
        "profile_url": {"pattern": "^https://github\\.com/[A-Za-z0-9-]+$"}
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "canonical_path", "coordination_issue_url"],
      "properties": {
        "method": {"const": "superseding-reviewed-record"},
        "canonical_path": {"const": "data/arena/github-models-retirement.json"},
        "coordination_issue_url": {"pattern": "^https://github\\.com/[^/]+/[^/]+/issues/[0-9]+$"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "github-models-retirement-authority@4"},
    "source_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_url",
        "retired_on",
        "observed_at",
        "observer",
        "revocation",
        "statement_digest"
      ],
      "properties": {
        "status": {"const": "source-observation"},
        "source_url": {"pattern": "^https://github\\.blog/changelog/[^?#]+/$"},
        "retired_on": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "observed_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "observer": {"$ref": "#/$defs/actor"},
        "revocation": {"$ref": "#/$defs/revocation"},
        "statement_digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "enforcement_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "provider_id",
        "catalog_url",
        "model_prefix",
        "effective_at",
        "decided_at",
        "decision_authority",
        "rationale",
        "historical_run_handling",
        "source_statement_digest",
        "revocation",
        "policy_digest"
      ],
      "properties": {
        "status": {"const": "fail-closed-enforcement-policy"},
        "provider_id": {"pattern": "^[a-z0-9][a-z0-9-]*$"},
        "catalog_url": {"pattern": "^https://[^?#]+$"},
        "model_prefix": {"pattern": "^[a-z0-9][a-z0-9-]*/$"},
        "effective_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "decided_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "decision_authority": {"$ref": "#/$defs/actor"},
        "rationale": {"const": "day-after-announced-retirement-date"},
        "historical_run_handling": {"const": "preserve-no-rejudging"},
        "source_statement_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "revocation": {"$ref": "#/$defs/revocation"},
        "policy_digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "record_digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
