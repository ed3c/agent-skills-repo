{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/agent-skills-repo/contracts/skill-arena-roadmap.schema.json",
  "title": "SKILL.md Arena roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed_on",
    "epic_issue",
    "authority",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-arena-roadmap@1"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "epic_issue": {
      "type": "integer",
      "minimum": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordination",
        "delivery",
        "projection"
      ],
      "properties": {
        "coordination": {
          "type": "string",
          "minLength": 1
        },
        "delivery": {
          "type": "string",
          "minLength": 1
        },
        "projection": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/roadmapItem"
      }
    }
  },
  "$defs": {
    "roadmapItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "title",
        "phase",
        "priority",
        "status",
        "evidence",
        "dependencies",
        "exit_evidence"
      ],
      "properties": {
        "issue": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "P0 Truth",
            "P0 Portability",
            "P1 Benchmark",
            "P1 Experiment",
            "P1 Corpus",
            "P1 Statistics",
            "P2 Trust",
            "P2 Product"
          ]
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "status": {
          "enum": [
            "backlog",
            "ready",
            "blocked",
            "in_progress",
            "in_review",
            "human_gate",
            "done"
          ]
        },
        "evidence": {
          "enum": [
            "missing",
            "local_only",
            "pr",
            "reachable_on_main",
            "independently_verified"
          ]
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "exit_evidence": {
          "type": "string",
          "minLength": 1
        },
        "landing": {
          "$ref": "#/$defs/landingEvidence"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "done"
              }
            }
          },
          "then": {
            "required": [
              "landing"
            ],
            "properties": {
              "evidence": {
                "enum": [
                  "reachable_on_main",
                  "independently_verified"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "evidence"
            ],
            "properties": {
              "evidence": {
                "enum": [
                  "reachable_on_main",
                  "independently_verified"
                ]
              }
            }
          },
          "then": {
            "required": [
              "landing"
            ]
          }
        }
      ]
    },
    "landingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "paths_digest",
        "test_evidence_digest"
      ],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "paths_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "test_evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
