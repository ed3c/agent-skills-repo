{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "resolver-decision-receipt@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "receipt_hash", "issuer_key_id", "signature"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "receipt_id", "request_digest", "request_id",
        "authorization_nonce", "execution_attempt_id",
        "workload_identity_receipt_hash", "workload_identity_issuer_key_id",
        "subject", "trust_domain",
        "carrier_id", "identity_audience", "decision_hash", "outcome",
        "selected_skill", "skill_artifact_digest", "qualification_receipt_id",
        "qualification_receipt_hash", "snapshot_hash", "snapshot_sequence",
        "revocation_source_sequence", "input_fingerprint", "ranking_policy_id",
        "resolver_build", "host_profile_id", "host_version",
        "transport_profile", "policy_profile", "human_approval_policy_id",
        "policy_snapshot_hash", "audience", "authorization_policy_hash",
        "issued_at", "not_before", "expires_at"
      ],
      "properties": {
        "schema_version": {"const": "resolver-decision-receipt@1"},
        "receipt_id": {"type": "string", "minLength": 1},
        "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "request_id": {"type": "string", "minLength": 1},
        "authorization_nonce": {"type": "string", "pattern": "^[0-9a-f]{32,128}$"},
        "execution_attempt_id": {"type": "string", "minLength": 1},
        "workload_identity_receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "workload_identity_issuer_key_id": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "trust_domain": {"type": "string", "minLength": 1},
        "carrier_id": {"type": "string", "minLength": 1},
        "identity_audience": {"type": "string", "minLength": 1},
        "decision_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "outcome": {"const": "resolved"},
        "selected_skill": {"type": "string", "minLength": 1},
        "skill_artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "qualification_receipt_id": {"type": "string", "minLength": 1},
        "qualification_receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "snapshot_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "snapshot_sequence": {"type": "integer", "minimum": 1},
        "revocation_source_sequence": {"type": "integer", "minimum": 0},
        "input_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "ranking_policy_id": {"const": "lexical-fixed-point@1"},
        "resolver_build": {"type": "string", "minLength": 1},
        "host_profile_id": {"type": "string", "minLength": 1},
        "host_version": {"type": "string", "minLength": 1},
        "transport_profile": {"type": "string", "minLength": 1},
        "policy_profile": {"type": "string", "minLength": 1},
        "human_approval_policy_id": {"type": "string", "minLength": 1},
        "policy_snapshot_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "audience": {"type": "string", "minLength": 1},
        "authorization_policy_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "issued_at": {"type": "string", "format": "date-time"},
        "not_before": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "issuer_key_id": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "minLength": 1}
  }
}
