{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/agent-skills-repo/contracts/agent-skills-export.schema.json",
  "title": "Portable Agent Skills export artifacts",
  "oneOf": [
    {"$ref": "#/$defs/export_manifest"},
    {"$ref": "#/$defs/registry"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "full_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "portable_name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "file_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "license",
        "validator",
        "validator_subdirectory",
        "required_in_ci"
      ],
      "properties": {
        "repository": {"const": "agentskills/agentskills"},
        "commit": {"$ref": "#/$defs/full_sha"},
        "license": {"const": "Apache-2.0"},
        "validator": {"const": "skills-ref validate"},
        "validator_subdirectory": {"const": "skills-ref"},
        "required_in_ci": {"const": true}
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "kind", "detail"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["additive", "byte-preserving", "deterministic-lossless", "metadata-only"]
        },
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "directory",
        "version",
        "artifact_digest",
        "lifecycle_status",
        "lifecycle_source",
        "production_routable"
      ],
      "properties": {
        "skill_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$"
        },
        "directory": {
          "type": "string",
          "pattern": "^skills/[a-z0-9]+(?:[_-][a-z0-9]+)*$"
        },
        "version": {"type": "string", "minLength": 1},
        "artifact_digest": {"$ref": "#/$defs/sha256"},
        "lifecycle_status": {"type": "string", "minLength": 1},
        "lifecycle_source": {"type": "string", "minLength": 1},
        "production_routable": {"type": "boolean"}
      }
    },
    "portable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "directory", "artifact_digest", "files"],
      "properties": {
        "name": {"$ref": "#/$defs/portable_name"},
        "directory": {
          "type": "string",
          "pattern": "^dist/agent-skills/[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "artifact_digest": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/file_entry"}
        }
      }
    },
    "export_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "portable",
        "upstream_conformance",
        "transformations",
        "losses"
      ],
      "properties": {
        "schema_version": {"const": "agent-skills-export@1"},
        "source": {"$ref": "#/$defs/source"},
        "portable": {"$ref": "#/$defs/portable"},
        "upstream_conformance": {"$ref": "#/$defs/upstream"},
        "transformations": {
          "type": "array",
          "minItems": 5,
          "items": {"$ref": "#/$defs/transformation"}
        },
        "losses": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "registry_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_skill_id",
        "portable_name",
        "source_artifact_digest",
        "portable_artifact_digest",
        "lifecycle_status",
        "production_routable",
        "export_manifest"
      ],
      "properties": {
        "source_skill_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$"
        },
        "portable_name": {"$ref": "#/$defs/portable_name"},
        "source_artifact_digest": {"$ref": "#/$defs/sha256"},
        "portable_artifact_digest": {"$ref": "#/$defs/sha256"},
        "lifecycle_status": {"type": "string", "minLength": 1},
        "production_routable": {"type": "boolean"},
        "export_manifest": {
          "type": "string",
          "pattern": "^dist/agent-skills/[a-z0-9]+(?:-[a-z0-9]+)*/export-manifest\\.json$"
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "upstream_agent_skills",
        "skills",
        "registry_digest"
      ],
      "properties": {
        "schema_version": {"const": "agent-skills-registry@1"},
        "upstream_agent_skills": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "license", "validator"],
          "properties": {
            "repository": {"const": "agentskills/agentskills"},
            "commit": {"$ref": "#/$defs/full_sha"},
            "license": {"const": "Apache-2.0"},
            "validator": {"const": "skills-ref validate"}
          }
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/registry_row"}
        },
        "registry_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
