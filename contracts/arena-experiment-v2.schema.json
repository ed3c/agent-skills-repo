{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/agent-skills-repo/contracts/arena-experiment-v2.schema.json",
  "title": "Arena paired experiment v2 documents",
  "oneOf": [
    {"$ref": "#/$defs/spec"},
    {"$ref": "#/$defs/plan"},
    {"$ref": "#/$defs/plan_envelope"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]{0,191}$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "task_family", "task_bundle_digest"],
      "properties": {
        "task_id": {"$ref": "#/$defs/identifier"},
        "task_family": {"$ref": "#/$defs/identifier"},
        "task_bundle_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id", "pairing_key", "task_id", "task_bundle_digest",
        "repetition", "block_seed", "agent_seed", "arm_order", "invocation_ids"
      ],
      "properties": {
        "block_id": {"$ref": "#/$defs/identifier"},
        "pairing_key": {"$ref": "#/$defs/sha256"},
        "task_id": {"$ref": "#/$defs/identifier"},
        "task_bundle_digest": {"$ref": "#/$defs/sha256"},
        "repetition": {"type": "integer", "minimum": 1},
        "block_seed": {"type": "integer", "minimum": 0},
        "agent_seed": {"type": ["integer", "null"], "minimum": 0},
        "arm_order": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": {"enum": ["baseline", "candidate"]}
        },
        "invocation_ids": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "block_id", "pairing_key", "task_id", "task_family",
        "task_bundle_digest", "arm", "skill_artifact_digest", "agent_id",
        "model_id", "harness_id", "harness_version", "sandbox_profile_id",
        "environment_image_digest", "policy_digest", "network_policy",
        "allowed_tools_digest", "repetition", "block_seed", "agent_seed",
        "order_index", "workspace_policy", "invocation_id"
      ],
      "properties": {
        "schema_version": {"const": "arena-experiment-invocation@1"},
        "block_id": {"$ref": "#/$defs/identifier"},
        "pairing_key": {"$ref": "#/$defs/sha256"},
        "task_id": {"$ref": "#/$defs/identifier"},
        "task_family": {"$ref": "#/$defs/identifier"},
        "task_bundle_digest": {"$ref": "#/$defs/sha256"},
        "arm": {"enum": ["baseline", "candidate"]},
        "skill_artifact_digest": {"$ref": "#/$defs/sha256"},
        "agent_id": {"$ref": "#/$defs/identifier"},
        "model_id": {"$ref": "#/$defs/identifier"},
        "harness_id": {"$ref": "#/$defs/identifier"},
        "harness_version": {"$ref": "#/$defs/identifier"},
        "sandbox_profile_id": {"$ref": "#/$defs/identifier"},
        "environment_image_digest": {"$ref": "#/$defs/sha256"},
        "policy_digest": {"$ref": "#/$defs/sha256"},
        "network_policy": {"enum": ["no-network", "allowlisted", "public"]},
        "allowed_tools_digest": {"$ref": "#/$defs/sha256"},
        "repetition": {"type": "integer", "minimum": 1},
        "block_seed": {"type": "integer", "minimum": 0},
        "agent_seed": {"type": ["integer", "null"], "minimum": 0},
        "order_index": {"type": "integer", "minimum": 0, "maximum": 1},
        "workspace_policy": {"const": "fresh-ephemeral-per-invocation"},
        "invocation_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "experiment_id", "tasks",
        "baseline_skill_artifact_digest", "candidate_skill_artifact_digest",
        "placebo_skill_artifact_digest", "study_protocol_digest", "agent_id",
        "model_id", "harness_id", "harness_version", "sandbox_profile_id",
        "environment_image_digest", "policy_digest", "network_policy",
        "allowed_tools_digest", "repetitions", "randomization_seed",
        "agent_seed_mode", "preregistered_at"
      ],
      "properties": {
        "schema_version": {"const": "arena-experiment-spec@2"},
        "experiment_id": {"$ref": "#/$defs/identifier"},
        "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
        "baseline_skill_artifact_digest": {"$ref": "#/$defs/sha256"},
        "candidate_skill_artifact_digest": {"$ref": "#/$defs/sha256"},
        "placebo_skill_artifact_digest": {"type": "null"},
        "study_protocol_digest": {"$ref": "#/$defs/sha256"},
        "agent_id": {"$ref": "#/$defs/identifier"},
        "model_id": {"$ref": "#/$defs/identifier"},
        "harness_id": {"$ref": "#/$defs/identifier"},
        "harness_version": {"$ref": "#/$defs/identifier"},
        "sandbox_profile_id": {"$ref": "#/$defs/identifier"},
        "environment_image_digest": {"$ref": "#/$defs/sha256"},
        "policy_digest": {"$ref": "#/$defs/sha256"},
        "network_policy": {"enum": ["no-network", "allowlisted", "public"]},
        "allowed_tools_digest": {"$ref": "#/$defs/sha256"},
        "repetitions": {"type": "integer", "minimum": 3, "maximum": 100},
        "randomization_seed": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "agent_seed_mode": {"enum": ["deterministic", "unavailable"]},
        "preregistered_at": {"type": "string", "format": "date-time"}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "randomization_algorithm", "failure_denominator_policy",
        "workspace_policy", "spec", "arms", "blocks", "invocations",
        "planned_invocation_count", "required_evidence_files", "plan_digest"
      ],
      "properties": {
        "schema_version": {"const": "arena-experiment-plan@2"},
        "randomization_algorithm": {"const": "sha256-arm-sort@1"},
        "failure_denominator_policy": {"const": "all-preregistered-invocations-count"},
        "workspace_policy": {"const": "fresh-ephemeral-per-invocation"},
        "spec": {"$ref": "#/$defs/spec"},
        "arms": {"const": ["baseline", "candidate"]},
        "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}},
        "invocations": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/invocation"}},
        "planned_invocation_count": {"type": "integer", "minimum": 6},
        "required_evidence_files": {"type": "array", "minItems": 7, "items": {"type": "string"}, "uniqueItems": true},
        "plan_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "plan_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "payload", "plan_hash", "issuer_key_id", "signature"],
      "properties": {
        "schema_version": {"const": "arena-experiment-plan-envelope@2"},
        "payload": {"$ref": "#/$defs/plan"},
        "plan_hash": {"$ref": "#/$defs/sha256"},
        "issuer_key_id": {"$ref": "#/$defs/identifier"},
        "signature": {"type": "string", "minLength": 1}
      }
    }
  }
}
