{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qualification-cost-receipt@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "receipt_hash", "issuer_key_id", "signature"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "receipt_id",
        "qualification_receipt_id",
        "skill_artifact_digest",
        "benchmark_suite_digest",
        "sandbox_receipt_set_digest",
        "host_profile_id",
        "host_version",
        "transport_profile",
        "policy_profile",
        "host_attestation_evidence_digest",
        "runner_digest",
        "environment_image_digest",
        "measurement_evidence_digest",
        "metering_profile_id",
        "pricing_policy_digest",
        "cost_unit",
        "quantities",
        "costs",
        "total_cost_microunits",
        "measurement_started_at",
        "measurement_completed_at",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "schema_version": {"const": "qualification-cost-receipt@1"},
        "receipt_id": {"type": "string", "minLength": 1},
        "qualification_receipt_id": {"type": "string", "minLength": 1},
        "skill_artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "benchmark_suite_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sandbox_receipt_set_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "host_profile_id": {"type": "string", "minLength": 1},
        "host_version": {"type": "string", "minLength": 1},
        "transport_profile": {"type": "string", "minLength": 1},
        "policy_profile": {"type": "string", "minLength": 1},
        "host_attestation_evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "runner_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "environment_image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "measurement_evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "metering_profile_id": {"type": "string", "minLength": 1},
        "pricing_policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "cost_unit": {"const": "usd_microunit@1"},
        "quantities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu_time_us",
            "memory_byte_seconds",
            "host_license_time_us",
            "sandbox_startup_count",
            "judge_input_tokens",
            "judge_output_tokens",
            "human_review_time_us",
            "storage_byte_seconds",
            "case_count",
            "retry_count"
          ],
          "properties": {
            "cpu_time_us": {"type": "integer", "minimum": 0},
            "memory_byte_seconds": {"type": "integer", "minimum": 0},
            "host_license_time_us": {"type": "integer", "minimum": 0},
            "sandbox_startup_count": {"type": "integer", "minimum": 0},
            "judge_input_tokens": {"type": "integer", "minimum": 0},
            "judge_output_tokens": {"type": "integer", "minimum": 0},
            "human_review_time_us": {"type": "integer", "minimum": 0},
            "storage_byte_seconds": {"type": "integer", "minimum": 0},
            "case_count": {"type": "integer", "minimum": 1},
            "retry_count": {"type": "integer", "minimum": 0}
          }
        },
        "costs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compute_microunits",
            "memory_microunits",
            "host_license_microunits",
            "sandbox_startup_microunits",
            "judge_microunits",
            "human_review_microunits",
            "storage_microunits"
          ],
          "properties": {
            "compute_microunits": {"type": "integer", "minimum": 0},
            "memory_microunits": {"type": "integer", "minimum": 0},
            "host_license_microunits": {"type": "integer", "minimum": 0},
            "sandbox_startup_microunits": {"type": "integer", "minimum": 0},
            "judge_microunits": {"type": "integer", "minimum": 0},
            "human_review_microunits": {"type": "integer", "minimum": 0},
            "storage_microunits": {"type": "integer", "minimum": 0}
          }
        },
        "total_cost_microunits": {"type": "integer", "minimum": 0},
        "measurement_started_at": {"type": "string", "format": "date-time"},
        "measurement_completed_at": {"type": "string", "format": "date-time"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issuer_key_id": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "minLength": 1}
  }
}
