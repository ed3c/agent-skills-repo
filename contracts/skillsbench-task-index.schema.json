{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/agent-skills-repo/contracts/skillsbench-task-index.schema.json",
  "title": "SkillsBench task bundle index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "upstream_repository",
    "upstream_commit",
    "bundles",
    "index_digest"
  ],
  "properties": {
    "schema_version": {"const": "arena-task-bundle-index@1"},
    "upstream_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "upstream_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/bundleRow"}
    },
    "index_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bundleRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "role",
        "bundle_digest",
        "bundle_path",
        "parity_status",
        "ranking_eligible"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "role": {
          "enum": ["code", "document-data", "skill-composition"]
        },
        "bundle_digest": {"$ref": "#/$defs/sha256"},
        "bundle_path": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/sha256-[0-9a-f]{64}$"
        },
        "parity_status": {
          "enum": ["equivalent", "known_loss", "rejected"]
        },
        "ranking_eligible": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"parity_status": {"const": "equivalent"}}
          },
          "then": {
            "properties": {"ranking_eligible": {"const": true}}
          }
        },
        {
          "if": {
            "properties": {
              "parity_status": {"enum": ["known_loss", "rejected"]}
            }
          },
          "then": {
            "properties": {"ranking_eligible": {"const": false}}
          }
        }
      ]
    }
  }
}
