{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/agent-skills-repo/contracts/skillsbench-task-bundle.schema.json",
  "title": "Content-addressed SkillsBench task bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "upstream", "task", "skill_injection", "files", "bundle_digest"],
  "properties": {
    "schema_version": {"const": "arena-task-bundle@1"},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "license", "license_path", "license_file_sha256", "task_path"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"type": "string", "minLength": 1},
        "license_path": {"type": "string", "minLength": 1},
        "license_file_sha256": {"$ref": "#/$defs/sha256"},
        "task_path": {"type": "string", "pattern": "^tasks/[a-z0-9]+(?:-[a-z0-9]+)*$"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "role", "schema_version", "category", "subcategory", "modality", "interface", "skill_type", "network_mode", "task_md_sha256", "prompt_sha256"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "role": {"enum": ["code", "document-data", "skill-composition"]},
        "schema_version": {"const": "1.3"},
        "category": {"type": "string", "minLength": 1},
        "subcategory": {"type": ["string", "null"]},
        "modality": {"$ref": "#/$defs/stringArray"},
        "interface": {"$ref": "#/$defs/stringArray"},
        "skill_type": {"$ref": "#/$defs/stringArray"},
        "network_mode": {"enum": ["public", "no-network"]},
        "task_md_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "skill_injection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "skill_names", "baseline_contract", "candidate_contract"],
      "properties": {
        "root": {"const": "environment/skills"},
        "skill_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "baseline_contract": {"type": "string", "minLength": 1},
        "candidate_contract": {"type": "string", "minLength": 1}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fileEntry"}
    },
    "bundle_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "git_mode"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "git_mode": {"enum": ["100644", "100755"]}
      }
    }
  }
}
